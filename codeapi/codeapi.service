[Unit]
Description=Catch-all code extractor API
After=network.target dovecot.service
Wants=dovecot.service

[Service]
Type=simple
EnvironmentFile=/etc/codeapi/env
WorkingDirectory=/opt/mailserver/codeapi
ExecStart=/usr/bin/gunicorn --bind 0.0.0.0:8443 --certfile=/etc/letsencrypt/live/__HOSTNAME__/fullchain.pem --keyfile=/etc/letsencrypt/live/__HOSTNAME__/privkey.pem --workers 2 --access-logfile - --error-logfile - server:app
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
User=root
Group=root

[Install]
WantedBy=multi-user.target
