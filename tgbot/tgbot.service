[Unit]
Description=Telegram bot: forward verification codes from catch-all mailbox
After=network-online.target dovecot.service
Wants=network-online.target dovecot.service

[Service]
Type=simple
EnvironmentFile=/etc/tgbot/env
ExecStart=/usr/bin/python3 /opt/mailserver/tgbot/bot.py
Restart=always
RestartSec=5
User=tgbot
Group=tgbot
StateDirectory=tgbot
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
